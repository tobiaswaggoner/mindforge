# Server
PORT=4202
NODE_ENV=development

# Database (PostgreSQL on minix-k3s K8s cluster via Tailscale)
DATABASE_URL=postgres://hiddenstories_user:hiddenstories_pass@minix-k3s:30432/mindforge_core

# JWT (must match auth-api secret)
JWT_SECRET=your-super-secret-key-at-least-32-characters
JWT_ISSUER=https://auth.mindforge-hub.de
JWT_AUDIENCE=mindforge

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201

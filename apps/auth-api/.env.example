# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL on minix-k3s K8s cluster via Tailscale)
DATABASE_URL=postgres://hiddenstories_user:hiddenstories_pass@minix-k3s:30432/mindforge_auth

# JWT (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=your-super-secret-key-at-least-32-characters
JWT_ISSUER=https://auth.mindforge-hub.de
JWT_AUDIENCE=mindforge

# Email (Mailgun) - optional for development
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=mg.mindforge.de
# MAILGUN_FROM=MindForge <noreply@mindforge.de>

# App URLs
AUTH_UI_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201

# Rate Limiting (per minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT_PASSWORD=3
